# Enable rewrite engine
RewriteEngine On

# Set rewrite base
RewriteBase /

# Allow direct access to actual files
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Handle API routes
RewriteRule ^api/ router.php [QSA,L]

# Handle clean URLs for main sections
RewriteRule ^(products|categories|product|about|quarry|mission|contacts|cart|wishlist|login|register|account|logout|privacy-policy|terms-of-service)(/.*)?$ router.php [QSA,L]

# Route all other requests through router.php
RewriteRule ^([^.]+)$ router.php [QSA,L]

# Prevent directory listing
Options -Indexes

# Handle errors
ErrorDocument 404 /404
ErrorDocument 500 /500

# PHP settings
php_flag display_startup_errors on
php_flag display_errors on
php_flag html_errors on

# Default charset
AddDefaultCharset UTF-8